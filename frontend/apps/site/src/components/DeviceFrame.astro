---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  variant?: "iphone" | "ipad";
  glow?: boolean;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  variant = "iphone",
  glow = false,
  priority = false,
  class: className = "",
} = Astro.props;

const widths = variant === "iphone" ? [320, 390, 640, 780] : [700, 1000, 1400, 2000];
const sizes =
  variant === "iphone"
    ? "(max-width: 720px) 78vw, 340px"
    : "(max-width: 900px) 92vw, 860px";
---

<div class={`device device--${variant} ${className}`}>
  {glow && <span class="device__glow" aria-hidden="true"></span>}
  {
    variant === "iphone" && (
      <div class="device__statusbar" aria-hidden="true">
        <span class="device__time">9:41</span>
        <span class="device__island" />
        <span class="device__glyphs">
          <svg width="15" height="10" viewBox="0 0 15 10" fill="currentColor"><rect x="0" y="6" width="2.6" height="4" rx="0.6"/><rect x="4" y="4" width="2.6" height="6" rx="0.6"/><rect x="8" y="2" width="2.6" height="8" rx="0.6"/><rect x="12" y="0" width="2.6" height="10" rx="0.6"/></svg>
          <svg width="14" height="10" viewBox="0 0 14 10" fill="currentColor"><path d="M7 8.6a1.4 1.4 0 1 0 0 1.4 1.4 1.4 0 0 0 0-1.4zM7 5.5c-1.5 0-2.9.6-3.9 1.6l1.2 1.2A3.9 3.9 0 0 1 7 7.2c1 0 2 .4 2.7 1.1l1.2-1.2A5.4 5.4 0 0 0 7 5.5zM7 2.3A8.6 8.6 0 0 0 .9 4.9l1.2 1.2A6.9 6.9 0 0 1 7 4c1.9 0 3.6.7 4.9 2l1.2-1.2A8.6 8.6 0 0 0 7 2.3z" transform="translate(0 -1.5)"/></svg>
          <svg width="22" height="11" viewBox="0 0 22 11" fill="none"><rect x="0.5" y="0.5" width="18" height="10" rx="2.5" stroke="currentColor" opacity="0.5"/><rect x="2" y="2" width="13" height="7" rx="1.4" fill="currentColor"/><path d="M20 3.5v4c1-.3 1.6-1.1 1.6-2s-.6-1.7-1.6-2z" fill="currentColor" opacity="0.5"/></svg>
        </span>
      </div>
    )
  }
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={82}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
  />
</div>

<style>
  .device {
    position: relative;
    background: #101013;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.9),
      0 24px 70px rgba(0, 0, 0, 0.55),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    line-height: 0;
  }

  .device :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .device--iphone {
    padding: 11px;
    border-radius: 52px;
    max-width: 340px;
  }
  .device--iphone :global(img) {
    border-radius: 0 0 42px 42px;
  }

  /* Hardware side buttons: power (right), volume rocker (left) */
  .device--iphone::before,
  .device--iphone::after {
    content: "";
    position: absolute;
    width: 3px;
    background: rgba(255, 255, 255, 0.22);
    border-radius: 2px;
  }
  .device--iphone::before {
    right: -3px;
    top: 22%;
    height: 64px;
  }
  .device--iphone::after {
    left: -3px;
    top: 18%;
    height: 92px;
    background:
      linear-gradient(
        rgba(255, 255, 255, 0.22) 0 26px,
        transparent 26px 38px,
        rgba(255, 255, 255, 0.22) 38px 92px
      );
  }

  /* Native-style iOS status bar drawn above the (header-cropped) screenshot */
  .device__statusbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 42px;
    padding: 6px 26px 0;
    background: #000;
    border-radius: 42px 42px 0 0;
  }

  .device__time {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1;
    color: #fff;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .device__island {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 92px;
    height: 26px;
    background: #0a0a0a;
    border-radius: 100px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .device__glyphs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
  }

  .device--ipad {
    padding: 18px;
    border-radius: 34px;
    max-width: 900px;
  }
  .device--ipad :global(img) {
    border-radius: 18px;
  }

  .device__glow {
    position: absolute;
    inset: -12%;
    z-index: -1;
    background: radial-gradient(
      ellipse at 50% 40%,
      rgba(0, 212, 170, 0.28),
      rgba(0, 212, 170, 0.07) 45%,
      transparent 70%
    );
    filter: blur(28px);
    pointer-events: none;
  }
</style>
