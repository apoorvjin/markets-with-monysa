---
// Monoline icon set — Feather/Lucide-style geometry, drawn with currentColor
// so each icon inherits the accent tint from its badge. No emoji anywhere.
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 22, class: className = "" } = Astro.props;

const icons: Record<string, string> = {
  // ── Personas ──
  radar: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><path d="M12 12 18.5 5.5"/><circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none"/>`,
  bolt: `<path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13z"/>`,
  shield: `<path d="M12 3 5 6v5.5c0 4.5 3 7.5 7 8.5 4-1 7-4 7-8.5V6z"/><path d="M9 12l2 2 4-4"/>`,

  // ── Bento ──
  bell: `<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>`,
  flask: `<path d="M9 3h6"/><path d="M10 3v6.5L4.8 18.4A1 1 0 0 0 5.7 20h12.6a1 1 0 0 0 .9-1.6L14 9.5V3"/><path d="M7.5 14.5h9"/>`,
  news: `<path d="M18 4H6a2 2 0 0 0-2 2v13a1 1 0 0 0 1 1h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Z"/><path d="M8 8h8M8 12h8M8 16h5"/>`,
  comment: `<path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/><path d="M8 9h9M8 13h6"/>`,
  calendar: `<rect x="3.5" y="4.5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 2.5v4M16 2.5v4"/>`,
  "calendar-clock": `<path d="M8 2.5v4M16 2.5v4M3.5 9.5h17"/><path d="M20.5 12.5V6.5a2 2 0 0 0-2-2h-13a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h7"/><circle cx="17.5" cy="17.5" r="3.5"/><path d="M17.5 16v1.6l1.1 1.1"/>`,
  network: `<circle cx="5" cy="6" r="2.2"/><circle cx="19" cy="6" r="2.2"/><circle cx="12" cy="18" r="2.2"/><path d="M6.6 7.6 10.6 16M17.4 7.6 13.4 16M7.2 6h9.6"/>`,
  institution: `<path d="M3 21h18M4.5 21V10M9 21V10M15 21V10M19.5 21V10M3 10h18"/><path d="M12 3 20 8H4z"/>`,
  percent: `<circle cx="7" cy="7" r="2.4"/><circle cx="17" cy="17" r="2.4"/><path d="M18.5 5.5 5.5 18.5"/>`,
  dollar: `<path d="M12 2v20"/><path d="M17 6.2A4.2 3.2 0 0 0 12.6 4H10.3a3.4 3.4 0 0 0 0 6.8h3.4a3.4 3.4 0 0 1 0 6.8H10.8A4.2 3.2 0 0 1 7 15.4"/>`,
  globe: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/>`,
  "line-chart": `<path d="M4 4v16h16"/><path d="M7.5 14.5 11 10l3 3 4.5-6.5"/>`,
  star: `<path d="M12 3.2 14.7 8.9l6.3.9-4.6 4.4 1.1 6.2L12 17.4 6.5 20.4l1.1-6.2L3 9.8l6.3-.9z"/>`,
  contrast: `<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"/>`,
  rotate: `<path d="M20.5 12a8.5 8.5 0 1 1-2.8-6.3"/><path d="M20.5 4v4.5H16"/>`,
  clock: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.4 2"/>`,
};

const inner = icons[name] ?? "";
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
></svg>
