    font-size: 10.5px;
    line-height: 1.4;
    color: var(--text-faint);
  }

  .nav__links {
    display: none;
    gap: var(--s6);
    margin-left: auto;
  }

  .nav__links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav__links a:hover {
