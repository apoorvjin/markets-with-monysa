        <span class="mkt__dot" id="mkt-dot"></span>
        <span id="mkt-label">Markets</span>
        <svg class="mkt__chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="mkt__panel" id="mkt-panel" role="region" aria-label="Global exchange sessions">
