    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
    cursor: pointer;
  }

  .mkt__pill:hover { border-color: var(--border-strong); color: var(--text-primary); }

  .mkt__chev { opacity: 0.6; transition: transform 0.18s ease; }

  .mkt__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-muted);
    flex-shrink: 0;
  }

  .mkt__dot[data-open="true"] {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: mkt-pulse 1.8s ease-in-out infinite;
  }

  @keyframes mkt-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  .mkt__panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 268px;
    padding: 10px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: rgba(10, 10, 10, 0.97);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.6);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }

  .mkt:hover .mkt__panel,
  .mkt:focus-within .mkt__panel,
  .mkt[data-open="true"] .mkt__panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mkt:hover .mkt__chev,
  .mkt[data-open="true"] .mkt__chev { transform: rotate(180deg); }

  .mkt :global(.mkt__row) {
    display: grid;
    grid-template-columns: 8px 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 8px;
  }

  .mkt :global(.mkt__row:hover) { background: rgba(255, 255, 255, 0.04); }

  .mkt :global(.mkt__rdot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }

  .mkt :global(.mkt__row[data-open="true"] .mkt__rdot) {
    background: var(--accent);
    box-shadow: 0 0 7px var(--accent);
  }

  .mkt :global(.mkt__city) {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .mkt :global(.mkt__row[data-open="true"] .mkt__city) { color: var(--text-primary); }

  .mkt :global(.mkt__time) {
    font-size: 12px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .mkt :global(.mkt__state) {
