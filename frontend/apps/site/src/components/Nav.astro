    </nav>
    <a class="nav__cta" href="/#download">Get the app</a>
  </div>
</header>

<script is:inline>
  (function () {
    // Regular cash sessions in each exchange's own timezone, as minutes from
    // midnight. Arrays handle lunch breaks (Tokyo, Hong Kong, Shanghai).
    var MARKETS = [
      { city: "New York",  tz: "America/New_York",  sessions: [[570, 960]] },              // 09:30–16:00
      { city: "London",    tz: "Europe/London",     sessions: [[480, 990]] },              // 08:00–16:30
      { city: "Frankfurt", tz: "Europe/Berlin",     sessions: [[540, 1050]] },             // 09:00–17:30
      { city: "Mumbai",    tz: "Asia/Kolkata",      sessions: [[555, 930]] },              // 09:15–15:30
      { city: "Hong Kong", tz: "Asia/Hong_Kong",    sessions: [[570, 720], [780, 960]] },  // 09:30–12:00, 13:00–16:00
      { city: "Shanghai",  tz: "Asia/Shanghai",     sessions: [[570, 690], [780, 900]] },  // 09:30–11:30, 13:00–15:00
      { city: "Tokyo",     tz: "Asia/Tokyo",        sessions: [[540, 690], [750, 900]] },  // 09:00–11:30, 12:30–15:00
      { city: "Sydney",    tz: "Australia/Sydney",  sessions: [[600, 960]] },              // 10:00–16:00
    ];

    var pill = document.getElementById("mkt-pill");
    var dot = document.getElementById("mkt-dot");
    var label = document.getElementById("mkt-label");
    var rows = document.getElementById("mkt-rows");
    var wrap = document.getElementById("mkt");
    if (!pill || !dot || !label || !rows || !wrap) return;

    function zoned(tz) {
      var parts = new Intl.DateTimeFormat("en-US", {
        timeZone: tz, hour12: false, weekday: "short", hour: "2-digit", minute: "2-digit",
      }).formatToParts(new Date());
      var o = {};
      parts.forEach(function (p) { o[p.type] = p.value; });
      var h = parseInt(o.hour, 10) % 24;
      var m = parseInt(o.minute, 10);
      return {
        weekday: o.weekday,
        mins: h * 60 + m,
        label: String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0"),
      };
    }

    function isOpen(mk) {
      var z = zoned(mk.tz);
      if (z.weekday === "Sat" || z.weekday === "Sun") return { open: false, time: z.label };
      for (var i = 0; i < mk.sessions.length; i++) {
        if (z.mins >= mk.sessions[i][0] && z.mins < mk.sessions[i][1]) {
          return { open: true, time: z.label };
        }
      }
      return { open: false, time: z.label };
    }

    function update() {
      var openCount = 0;
      var html = "";
      MARKETS.forEach(function (mk) {
        var s = isOpen(mk);
        if (s.open) openCount++;
        html +=
          '<div class="mkt__row" data-open="' + s.open + '">' +
            '<span class="mkt__rdot"></span>' +
            '<span class="mkt__city">' + mk.city + "</span>" +
            '<span class="mkt__time num">' + s.time + "</span>" +
            '<span class="mkt__state">' + (s.open ? "Open" : "Closed") + "</span>" +
          "</div>";
      });
      rows.innerHTML = html;

      label.textContent =
        openCount > 0
          ? openCount + " of " + MARKETS.length + " markets open"
          : "All markets closed";
      dot.setAttribute("data-open", openCount > 0 ? "true" : "false");
      pill.hidden = false;
    }

    update();
    setInterval(update, 30000);

    // Click toggles on touch; hover/focus handled in CSS for pointer devices.
    pill.addEventListener("click", function () {
      var open = wrap.getAttribute("data-open") === "true";
      wrap.setAttribute("data-open", open ? "false" : "true");
      pill.setAttribute("aria-expanded", open ? "false" : "true");
    });
    document.addEventListener("click", function (e) {
      if (!wrap.contains(e.target)) {
        wrap.setAttribute("data-open", "false");
        pill.setAttribute("aria-expanded", "false");
      }
    });
  })();
</script>

<style>
