---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import DownloadCta from "../../components/DownloadCta.astro";
import { getTariffs, slugify, yearOf } from "../../lib/api";

const { countries, dataAsOf } = await getTariffs();
const rows = [...countries].sort((a, b) => (b.impactScore ?? 0) - (a.impactScore ?? 0));
const year = yearOf(dataAsOf);
const site = "https://www.finbrio.net";

const title = `US Tariff Rates by Country (${year}): 113+ Countries Ranked | FinBrio`;
const description = `Browse US tariff exposure across ${countries.length}+ countries — effective rate, per-sector detail and a 0–100 impact score for each. Sortable and searchable. Updated ${dataAsOf}.`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "US Tariffs", item: `${site}/tariffs` },
  ],
};
---

<Base
  title={title}
  description={description}
  ogTitle="US Tariffs, mapped across 113+ countries"
  ogDescription={`Effective rate, sector detail and a 0–100 impact score per country. Updated ${dataAsOf}.`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <Nav />

  <main id="main-content" class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>/</span> <span aria-current="page">US Tariffs</span>
    </nav>

    <header class="head">
      <p class="eyebrow">US Tariff Exposure</p>
      <h1>US tariff rates by country</h1>
      <p class="lead">
        How hard does US trade policy hit each economy? {countries.length} countries,
        ranked by a 0–100 impact score that blends the headline tariff rate, sector
        breadth and trade exposure to the US. Tap any country for the full per-sector
        breakdown and a plain-English explanation.
      </p>
      <p class="updated">Updated {dataAsOf} · source: USTR Section 301 &amp; Federal Register</p>
    </header>

    <div class="controls">
      <input
        id="q"
        type="search"
        placeholder="Search a country…"
        aria-label="Search countries"
        autocomplete="off"
      />
      <div class="sortby">
        <button data-sort="impact" class="is-active" type="button">Impact</button>
        <button data-sort="rate" type="button">Rate</button>
        <button data-sort="name" type="button">Name</button>
      </div>
    </div>

    <div class="tbl-scroll">
      <table class="tbl" id="tariff-table">
        <thead>
          <tr>
            <th scope="col">Country</th>
            <th scope="col" class="num">Tariff rate</th>
            <th scope="col" class="num">Impact</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((c) => (
              <tr
                data-name={c.countryName.toLowerCase()}
                data-rate={c.tariffRate}
                data-impact={c.impactScore ?? 0}
              >
                <th scope="row">
                  <a href={`/tariffs/${slugify(c.countryName)}`}>{c.countryName}</a>
                </th>
                <td class="num">{c.tariffRate}%</td>
                <td class="num">{c.impactScore ?? "—"}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <section class="cta-block">
      <h2>Track tariff exposure live — free</h2>
      <p>FinBrio's tariff browser updates as US trade policy shifts, with sector detail, impact scores and country deep-dives. Free on iOS and the web.</p>
      <DownloadCta />
    </section>
  </main>

  <footer class="foot">
    <a href="/">FinBrio</a>
    <nav>
      <a href="/tariffs">Tariffs</a>
      <a href="/us-debt-clock">US Debt Clock</a>
      <a href="/#macro">Macro</a>
      <a href="/#signals">Signals</a>
    </nav>
    <p>Informational only — not financial advice.</p>
  </footer>
</Base>

<script is:inline>
  (function () {
    var input = document.getElementById("q");
    var table = document.getElementById("tariff-table");
    if (!input || !table) return;
    var tbody = table.querySelector("tbody");
    var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr"));

    function filter() {
      var q = input.value.trim().toLowerCase();
      rows.forEach(function (r) {
        r.style.display = !q || r.getAttribute("data-name").indexOf(q) !== -1 ? "" : "none";
      });
    }
    input.addEventListener("input", filter);

    var buttons = document.querySelectorAll(".sortby button");
    function sortBy(key, dir) {
      var sorted = rows.slice().sort(function (a, b) {
        if (key === "name") {
          return a.getAttribute("data-name").localeCompare(b.getAttribute("data-name"));
        }
        return (
          (parseFloat(b.getAttribute("data-" + key)) - parseFloat(a.getAttribute("data-" + key))) * dir
        );
      });
      sorted.forEach(function (r) { tbody.appendChild(r); });
    }
    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        buttons.forEach(function (b) { b.classList.remove("is-active"); });
        btn.classList.add("is-active");
        var key = btn.getAttribute("data-sort");
        sortBy(key, 1);
      });
    });
  })();
</script>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: calc(var(--s8) * 1.5) var(--s5) var(--s8); }
  .crumbs { font-size: 13px; color: var(--text-muted); display: flex; gap: var(--s2); align-items: center; margin-bottom: var(--s6); }
  .crumbs a { color: var(--text-secondary); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .crumbs span[aria-current] { color: var(--text-primary); }

  .eyebrow { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 600; margin: 0 0 var(--s3); }
  h1 { font-size: clamp(30px, 6vw, 46px); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 var(--s5); color: var(--text-primary); }
  .lead { font-size: 17px; line-height: 1.7; color: var(--text-secondary); max-width: 66ch; margin: 0 0 var(--s4); }
  .updated { font-size: 13px; color: var(--text-muted); margin: 0 0 var(--s7); }

  .controls { display: flex; gap: var(--s4); flex-wrap: wrap; align-items: center; justify-content: space-between; margin-bottom: var(--s5); }
  #q { flex: 1 1 260px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: var(--s4) var(--s5); color: var(--text-primary); font-size: 15px; }
  #q:focus { outline: none; border-color: var(--accent); }
  .sortby { display: flex; gap: var(--s2); }
  .sortby button { background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary); border-radius: 100px; padding: var(--s3) var(--s5); font-size: 13px; font-weight: 600; cursor: pointer; }
  .sortby button.is-active { border-color: rgba(0, 212, 170, 0.4); color: var(--accent); }

  .tbl-scroll { overflow-x: auto; }
  .tbl { width: 100%; border-collapse: collapse; font-size: 15px; }
  .tbl th, .tbl td { text-align: left; padding: var(--s4); border-bottom: 1px solid var(--border); }
  .tbl thead th { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .tbl .num { text-align: right; font-variant-numeric: tabular-nums; }
  .tbl tbody th a { color: var(--text-primary); text-decoration: none; font-weight: 600; }
  .tbl tbody th a:hover { color: var(--accent); }
  .tbl tbody tr:hover { background: var(--surface); }

  .cta-block { text-align: center; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: var(--s8) var(--s6); margin: calc(var(--s8) * 1.2) 0; }
  .cta-block h2 { font-size: clamp(20px, 3.5vw, 26px); margin: 0 0 var(--s3); color: var(--text-primary); }
  .cta-block p { color: var(--text-secondary); max-width: 52ch; margin: 0 auto var(--s6); line-height: 1.6; }

  .foot { max-width: 900px; margin: 0 auto; padding: var(--s7) var(--s5) var(--s8); border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; gap: var(--s4); align-items: center; justify-content: space-between; font-size: 13px; color: var(--text-muted); }
  .foot > a { font-weight: 800; color: var(--text-primary); text-decoration: none; }
  .foot nav { display: flex; gap: var(--s5); }
  .foot nav a { color: var(--text-secondary); text-decoration: none; }
  .foot nav a:hover { color: var(--accent); }
  .foot p { margin: 0; width: 100%; }
</style>
