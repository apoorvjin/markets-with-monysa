<style>
  main {
    overflow-x: clip;
  }

  section {
    scroll-margin-top: 76px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--s4);
  }

  h2 {
    font-size: clamp(28px, 4.6vw, 44px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.015em;
