const faqItems = [
  {
    q: "What is FinBrio?",
    a: "FinBrio is a global financial intelligence app for iOS and Android. It brings live markets, AI-generated trade signals, smart-money tracking (presidential, insider and lobbying disclosures), US tariff exposure, ETF analytics, and macro stress monitoring into one dashboard — the data professionals watch, without the terminal price tag.",
  },
  {
    q: "What are AI trading signals?",
    a: "For 49+ assets across commodities, indices, forex, and crypto, FinBrio computes a BUY, HOLD, or SELL stance with a concrete entry, stop-loss, take-profit, risk/reward ratio, and confidence score — plus the reasoning behind it. Nine strategy engines (S1–S9) cover different trading styles, including S9, a silver-specific liquidity-sweep strategy. Every strategy ships with a walk-forward backtest showing win rate, drawdown and Sharpe so you can verify before you trust.",
  },
