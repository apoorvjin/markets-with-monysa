          class="waitlist__input"
          type="email"
          name="email"
          id="waitlist-email"
          placeholder="you@email.com"
          autocomplete="email"
          aria-label="Email address"
          required
        />
        <button class="waitlist__btn" type="submit">Notify me</button>
      </form>
      <p class="waitlist__msg" id="waitlist-msg" role="status" aria-live="polite" hidden></p>
    </Reveal>

    <script is:inline>
      (function () {
        var form = document.getElementById("waitlist");
        var input = document.getElementById("waitlist-email");
        var msg = document.getElementById("waitlist-msg");
        if (!form || !input || !msg) return;

        // Same-origin in production (proxied by vercel.json → the FinBrio API).
        var LOCAL = location.hostname === "localhost" || location.hostname === "127.0.0.1";
        var WAITLIST = LOCAL ? "http://localhost:5001/api/waitlist" : "/api/waitlist";

        function show(text, ok) {
          msg.textContent = text;
          msg.hidden = false;
          msg.setAttribute("data-state", ok ? "ok" : "err");
        }

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var email = (input.value || "").trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            show("Please enter a valid email.", false);
            return;
          }
          var btn = form.querySelector("button");
          btn.disabled = true;
          btn.textContent = "Adding…";

          fetch(WAITLIST, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: email, source: "site" }),
          })
            .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
            .then(function () {
              form.reset();
              show("You're on the list. We'll be in touch at launch.", true);
              btn.textContent = "Done ✓";
            })
            .catch(function () {
              // Endpoint not deployed yet or offline — fall back to email so
              // the intent is never lost.
              show("Almost — email us at hello@finbrio.net and we'll add you.", false);
              btn.disabled = false;
              btn.textContent = "Notify me";
            });
        });
      })();
    </script>

