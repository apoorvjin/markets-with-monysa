  { icon: "dollar", title: "US debt clock",
    copy: "The national debt ticking live from the US Treasury's own data, with context on what it means." },
  { icon: "globe", title: "Country deep-dives",
    copy: "GDP, trade balance and military spend per country from the World Bank — plus that country's listed stocks, including NSE/BSE for India." },
  { icon: "line-chart", title: "TradingView built in",
    copy: "Advanced TradingView charts inline, or one tap to open any symbol in the full TradingView app." },
  { icon: "star", title: "Watchlists",
    copy: "Star anything — commodities, indices, forex, crypto, stocks — and get your own market view first." },
  { icon: "contrast", title: "Your app, your way",
    copy: "Dark and light themes, adjustable type size, and your choice of chart engine. Small things, done right." },
  { icon: "rotate", title: "ETF rotation (RRG)",
    copy: "Relative Rotation Graph quadrants — Leading, Improving, Weakening, Lagging — for sectors and 42 curated ETFs." },
