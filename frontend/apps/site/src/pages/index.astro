  }

  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 72px 24px 88px;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  /* Faint trading-grid — the backdrop of every price chart */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 30%, transparent 80%);
  }

  /* Ghosted price line drawing across the hero */
  .hero__chart {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.7;
  }

  .hero__chart-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px rgba(0, 212, 170, 0.4));
    stroke-dasharray: 4200;
    stroke-dashoffset: 4200;
    animation: chart-draw 3.4s ease-out 0.2s forwards;
  }

  .hero__chart-area {
    opacity: 0;
    animation: chart-fill 1.6s ease-out 2.4s forwards;
  }

  .hero__depth {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 75% 15%, rgba(0, 212, 170, 0.1), transparent 70%);
  }

  @keyframes chart-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes chart-fill {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__chart-line {
      animation: none;
      stroke-dashoffset: 0;
    }
    .hero__chart-area {
      animation: none;
      opacity: 1;
    }
  }

  .hero__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
  }

  .hero__title {
    font-size: clamp(42px, 7.2vw, 76px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 0 0 var(--s6);
    color: var(--text-primary);
  }

  .hero__title-accent {
    background: linear-gradient(100deg, var(--accent), #7ef7dd);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    font-size: clamp(16px, 2.2vw, 19px);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 var(--s7);
    max-width: 54ch;
  }

  .hero__cta {
    scroll-margin-top: 100px;
  }

