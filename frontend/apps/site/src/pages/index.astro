---

<Base
  title="FinBrio — Global Markets, AI Signals & Macro Intelligence"
  description="One app for the whole market: 46 live indices, 23 commodities, 44 forex pairs, AI trade signals with entry/stop/target across 9 strategies, smart-money disclosures (presidential, insider and lobbying), US tariff exposure for 113+ countries, ETF analytics and macro stress monitoring. Live now on iOS and the web — Android coming soon."
  ogTitle="The market's unfair advantage."
  ogDescription="Live markets. AI trade signals. Macro intelligence. Smart money. Tariff exposure. One app."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <span id="top"></span>
  <Nav />

  <main id="main-content">
    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero__bg" aria-hidden="true">
        <div class="hero__grid"></div>
        <svg class="hero__chart" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="heroArea" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#00d4aa" stop-opacity="0.16" />
              <stop offset="100%" stop-color="#00d4aa" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path
            class="hero__chart-area"
            d="M0,430 L120,405 L240,438 L360,360 L480,388 L600,300 L720,338 L840,255 L960,292 L1080,205 L1200,242 L1320,150 L1440,192 L1440,600 L0,600 Z"
            fill="url(#heroArea)"
          />
          <path
            class="hero__chart-line"
            d="M0,430 L120,405 L240,438 L360,360 L480,388 L600,300 L720,338 L840,255 L960,292 L1080,205 L1200,242 L1320,150 L1440,192"
          />
        </svg>
        <span class="hero__depth"></span>
      </div>
      <div class="hero__inner">
        <Reveal as="div" class="hero__copy">
          <p class="eyebrow">Live now · Web &amp; iOS</p>
          <h1 class="hero__title">
            The market's<br />
            <span class="hero__title-accent">unfair advantage.</span>
          </h1>
          <p class="hero__subtitle">
            Live global markets, AI trade signals with exact entry, stop and target,
            the smart-money disclosures pros track, and the macro picture —
            all in one place.
          </p>
          <div class="hero__cta">
            <DownloadCta />
          </div>
          <p class="hero__audience">
            For the macro-curious who follow tariffs, smart-money disclosures and the debt
            clock — and the self-directed traders who act on them.
          </p>
        </Reveal>
        <Reveal as="div" class="hero__device">
          <DeviceFrame
            src={shotAsset}
            alt="FinBrio asset view: Apple candlestick chart with an AI BUY signal showing entry, stop loss, take profit and risk/reward"
            variant="iphone"
            glow
            priority
          />
        </Reveal>
      </div>
    </section>

    <TickerTape />

    <!-- ── Stats band ───────────────────────────────────────────────────── -->
    <Reveal as="section" class="stats">
      {
        stats.map((s) => (
          <div class="stats__cell">
            <div class="stats__value" data-count={s.value}>{s.value}</div>
            <div class="stats__label">{s.label}</div>
          </div>
        ))
      }
    </Reveal>
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var els = document.querySelectorAll("[data-count]");
        if (!els.length || !("IntersectionObserver" in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            io.unobserve(entry.target);
            var raw = entry.target.getAttribute("data-count") || "";
            var num = parseInt(raw, 10);
            if (isNaN(num)) return;
            var suffix = raw.replace(String(num), "");
            var start = null;
            var DURATION = 900;
            function step(ts) {
              if (start === null) start = ts;
              var p = Math.min((ts - start) / DURATION, 1);
              var eased = 1 - Math.pow(1 - p, 3);
              entry.target.textContent = Math.round(num * eased) + suffix;
              if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          });
        }, { threshold: 0.6 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <!-- ── Personas ─────────────────────────────────────────────────────── -->
    <section class="personas" id="personas">
      <Reveal as="div" class="personas__head">
        <p class="eyebrow">Who it's for</p>
        <h2>Three jobs. One app.</h2>
      </Reveal>
