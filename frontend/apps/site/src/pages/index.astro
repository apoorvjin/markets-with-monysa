  },
];

const appStoreUrl = "https://apps.apple.com/app/finbrio/id6783981998";
const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "FinBrio",
  operatingSystem: "iOS",
  applicationCategory: "FinanceApplication",
  description:
    "Global market intelligence: live markets, AI trading signals, smart-money disclosures (presidential, insider and lobbying), tariff exposure, ETF analytics, and macro stress monitoring in one app.",
  url: "https://www.finbrio.net",
  downloadUrl: appStoreUrl,
  installUrl: appStoreUrl,
  sameAs: [appStoreUrl],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
