  { src: shotSignals, alt: "AI signal board: BUY, HOLD, SELL calls with confidence percentages across commodities", caption: "Signal board — every asset, one verdict" },
  { src: shotScanner, alt: "10X Power Moves scanner on global indices with the v3 Super Pine engine", caption: "Power Moves — 10X breakout scanner" },
  { src: shotOge, alt: "Presidential financial disclosures from OGE Form 278-T filings", caption: "Presidential trades — from official filings" },
  { src: shotEtf, alt: "ETF explorer listing 42 curated ETFs with live prices across 7 categories", caption: "ETF explorer — 42 funds, 7 categories" },
  { src: shotForex, alt: "44 live forex pairs grouped by region", caption: "Forex — 44 pairs, grouped by region" },
