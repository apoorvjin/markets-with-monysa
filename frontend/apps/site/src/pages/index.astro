          variant="iphone"
        />
        <DeviceFrame
          src={shotInvesting}
          alt="US tariff exposure table ranking countries by tariff rate, from Russia at 200% downward"
          variant="iphone"
          class="feature__media-offset"
        />
      </Reveal>
    </section>

    <!-- ── Macro ────────────────────────────────────────────────────────── -->
    <section class="feature" id="macro">
      <Reveal as="div" class="feature__copy">
        <p class="eyebrow">Macro Intelligence</p>
        <h2>Know the regime<br />before you trade it.</h2>
        <p>
          A market-stress meter, VIX and Fear &amp; Greed gauges, the yield
          curve, sector rotation, and cross-asset correlations — distilled into
          one dashboard that tells you whether it's a bullish tape, a chop-fest,
