import Nav from "../components/Nav.astro";
import Reveal from "../components/Reveal.astro";
import DeviceFrame from "../components/DeviceFrame.astro";
import TickerTape from "../components/TickerTape.astro";
import DownloadCta from "../components/DownloadCta.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import SignalCard from "../components/SignalCard.astro";
import LiveBoard from "../components/LiveBoard.astro";

import shotAsset from "../assets/screens/iphone-asset.png";
